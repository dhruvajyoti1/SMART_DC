# ============================================================
# ML Model Binaries & Heavy Checkpoints (GitHub Safety: <50MB/100MB)
# Excluded to prevent GitHub GH001 large-file push rejections
# and repository bloat. Generate locally via notebooks 01-08.
# ============================================================
ml-pipeline/models/*.pkl
ml-pipeline/models/*.h5
ml-pipeline/models/*.keras
ml-pipeline/models/*.joblib
ml-pipeline/models/*.weights
ml-pipeline/models/*.pt
ml-pipeline/models/*.pth
ml-pipeline/models/*.onnx
!ml-pipeline/models/.gitkeep

